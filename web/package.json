{
  "name": "sheliak-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:worklet-host && vite",
    "build": "npm run build:worklet-host && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:cli": "vite build --config vite.cli.config.ts",
    "prepare": "npm run build:cli && npm run build:worklet-host",
    "build:worklet-host": "vite build --config vite.worklet.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
